APP_NAME=ADF Mock API Platform
DATABASE_PATH=./data/mock_api.db
SOURCES_MANIFEST=./data/sources.json
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# Local practice credentials only. Change before exposing publicly.
API_KEY=change-me-local-api-key
BASIC_USERNAME=adf_user
BASIC_PASSWORD=ChangeThis_Basic_123!
STATIC_BEARER_TOKEN=change-me-static-bearer-token

# Local OAuth2 client-credentials issuer (practice only)
OAUTH_CLIENT_ID=adf-spn-client
OAUTH_CLIENT_SECRET=ChangeThis_OAuth_Secret_123!
OAUTH_SIGNING_SECRET=replace-with-random-secret-minimum-32-characters
OAUTH_TOKEN_TTL_SECONDS=3600

# Real Microsoft Entra ID API JWT validation
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_REQUIRED_SCOPE=Data.Read
ENTRA_REQUIRED_ROLE=Data.Read.All

# Optional request throttling/delay demo
MAX_DELAY_SECONDS=60
